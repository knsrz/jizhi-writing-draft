{
  "name": "writing-app",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @app/desktop dev",
    "build": "pnpm --filter @app/desktop build",
    "dist": "pnpm --filter @app/desktop dist",
    "dist:mac": "pnpm --filter @app/desktop dist:mac",
    "dist:win": "pnpm --filter @app/desktop dist:win",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
