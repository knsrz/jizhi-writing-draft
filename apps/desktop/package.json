{
  "name": "@app/desktop",
  "version": "0.1.0",
  "description": "极致写作桌面客户端",
  "private": true,
  "license": "Apache-2.0",
  "author": "knsrz",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac dmg --arm64",
    "dist:win": "electron-vite build && electron-builder --win nsis --x64",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "@app/agent": "workspace:*",
    "@app/ai": "workspace:*",
    "@app/core": "workspace:*",
    "@app/knowledge": "workspace:*",
    "@lancedb/lancedb": "^0.18.0",
    "better-sqlite3": "^11.7.0",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "drizzle-orm": "^0.41.0",
    "lucide-react": "^1.14.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^38.8.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.11"
  }
}
